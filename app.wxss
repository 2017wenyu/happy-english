/* app.wxss - 全局样式 */
page {
  background-color: #F5F8FF;
  font-family: -apple-system, "PingFang SC", "Microsoft YaHei", sans-serif;
}

/* 通用按钮样式 */
.btn-primary {
  background: linear-gradient(135deg, #4876FF, #722ED1);
  color: #FFFFFF;
  border-radius: 48rpx;
  font-size: 34rpx;
  font-weight: 600;
  padding: 28rpx 60rpx;
  border: none;
  box-shadow: 0 8rpx 24rpx rgba(72, 118, 255, 0.35);
  letter-spacing: 2rpx;
}

.btn-primary:active {
  opacity: 0.85;
  transform: scale(0.97);
}

.btn-success {
  background: linear-gradient(135deg, #52C41A, #73D13D);
  color: #FFFFFF;
  border-radius: 48rpx;
  font-size: 34rpx;
  font-weight: 600;
  padding: 28rpx 60rpx;
  border: none;
  box-shadow: 0 8rpx 24rpx rgba(82, 196, 26, 0.3);
}

.btn-warning {
  background: linear-gradient(135deg, #FAAD14, #FFC53D);
  color: #FFFFFF;
  border-radius: 48rpx;
  font-size: 34rpx;
  font-weight: 600;
  padding: 28rpx 60rpx;
  border: none;
  box-shadow: 0 8rpx 24rpx rgba(250, 173, 20, 0.3);
}

.btn-danger {
  background: linear-gradient(135deg, #FF4D4F, #FF7875);
  color: #FFFFFF;
  border-radius: 48rpx;
  font-size: 34rpx;
  font-weight: 600;
  padding: 28rpx 60rpx;
  border: none;
  box-shadow: 0 8rpx 24rpx rgba(255, 77, 79, 0.3);
}

.btn-ghost {
  background: transparent;
  color: #4876FF;
  border-radius: 48rpx;
  font-size: 34rpx;
  font-weight: 600;
  padding: 26rpx 60rpx;
  border: 2rpx solid #4876FF;
}

/* 卡片容器 */
.card {
  background: #FFFFFF;
  border-radius: 24rpx;
  padding: 32rpx;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.06);
  margin: 16rpx 24rpx;
}

/* 页面标题 */
.page-title {
  font-size: 40rpx;
  font-weight: 700;
  color: #1a1a2e;
  padding: 40rpx 32rpx 16rpx;
}

/* 空状态 */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 120rpx 40rpx;
}

.empty-state .empty-icon {
  font-size: 100rpx;
  margin-bottom: 24rpx;
}

.empty-state .empty-text {
  font-size: 30rpx;
  color: #999;
  text-align: center;
}
