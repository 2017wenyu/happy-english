/* pages/poem_guess/poem_guess.wxss */
.container {
  min-height: 100vh;
  background: #FFF0F6;
  padding: 30rpx;
}

/* 游戏卡片 */
.game-card {
  background: #fff;
  border-radius: 24rpx;
  padding: 30rpx;
  box-shadow: 0 4rpx 20rpx rgba(235,47,150,0.08);
}

.progress-text {
  display: block;
  text-align: center;
  font-size: 24rpx;
  color: #999;
  margin-bottom: 30rpx;
}

/* 题目区 */
.question-box {
  background: linear-gradient(135deg, #FFADD2, #EB2F96);
  border-radius: 20rpx;
  padding: 40rpx;
  text-align: center;
  margin-bottom: 30rpx;
}

.question-icon {
  font-size: 60rpx;
  display: block;
  margin-bottom: 16rpx;
}

.question-title {
  display: block;
  font-size: 32rpx;
  font-weight: bold;
  color: #fff;
  margin-bottom: 16rpx;
}

.question-desc {
  display: block;
  font-size: 28rpx;
  color: rgba(255,255,255,0.9);
  line-height: 1.6;
}

/* 选项列表 */
.options-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  margin-bottom: 30rpx;
}

.option-item {
  background: #F5F5F5;
  border-radius: 16rpx;
  padding: 24rpx 30rpx;
  display: flex;
  align-items: center;
  position: relative;
  transition: all 0.3s;
}

.option-item:active {
  transform: scale(0.98);
}

.option-item.correct {
  background: #F6FFED;
  border: 2rpx solid #52C41A;
}

.option-item.wrong {
  background: #FFF1F0;
  border: 2rpx solid #FF4D4F;
}

.option-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
  margin-right: 16rpx;
}

.option-author {
  font-size: 24rpx;
  color: #999;
}

.result-icon {
  position: absolute;
  right: 30rpx;
  font-size: 36rpx;
  font-weight: bold;
}

.option-item.correct .result-icon {
  color: #52C41A;
}

.option-item.wrong .result-icon {
  color: #FF4D4F;
}

/* 反馈 */
.feedback-box {
  border-radius: 20rpx;
  overflow: hidden;
  margin-top: 4rpx;
}

.feedback-box.feedback-correct {
  border: 2rpx solid #52C41A;
}

.feedback-box.feedback-wrong {
  border: 2rpx solid #FF4D4F;
}

.feedback-header {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 24rpx 30rpx;
  gap: 12rpx;
}

.feedback-box.feedback-correct .feedback-header {
  background: #F6FFED;
}

.feedback-box.feedback-wrong .feedback-header {
  background: #FFF1F0;
}

.feedback-icon {
  font-size: 40rpx;
}

.feedback-text {
  font-size: 30rpx;
  font-weight: bold;
  color: #333;
}

/* 答题后展示古诗 */
.poem-reveal {
  background: #FFFBE6;
  padding: 30rpx;
}

.poem-reveal-header {
  text-align: center;
  margin-bottom: 20rpx;
}

.poem-reveal-title {
  display: block;
  font-size: 36rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 8rpx;
}

.poem-reveal-author {
  display: block;
  font-size: 24rpx;
  color: #888;
}

.poem-reveal-content {
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx 20rpx;
  margin-bottom: 20rpx;
}

.poem-reveal-line {
  display: block;
  font-size: 30rpx;
  color: #333;
  line-height: 1.9;
  text-align: center;
  font-family: serif;
}

.poem-reveal-translation {
  background: rgba(255,255,255,0.7);
  border-radius: 12rpx;
  padding: 20rpx;
}

.translation-label {
  display: block;
  font-size: 24rpx;
  font-weight: bold;
  color: #D48806;
  margin-bottom: 10rpx;
}

.translation-text {
  font-size: 24rpx;
  color: #666;
  line-height: 1.7;
}

/* 下一题按钮 */
.next-btn-wrap {
  padding: 20rpx 30rpx 30rpx;
  background: #FFFBE6;
}

.next-question-btn {
  width: 100%;
  height: 88rpx;
  line-height: 88rpx;
  background: linear-gradient(135deg, #EB2F96, #FF85C2);
  color: #fff;
  font-size: 32rpx;
  font-weight: bold;
  border-radius: 44rpx;
  text-align: center;
  margin: 0;
  padding: 0;
}





/* 完成卡片 */
.complete-card {
  background: #fff;
  border-radius: 24rpx;
  padding: 60rpx 40rpx;
  text-align: center;
  box-shadow: 0 4rpx 20rpx rgba(235,47,150,0.08);
}

.complete-icon {
  font-size: 100rpx;
  display: block;
  margin-bottom: 20rpx;
}

.complete-title {
  display: block;
  font-size: 48rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 16rpx;
}

.complete-sub {
  display: block;
  font-size: 28rpx;
  color: #666;
  margin-bottom: 40rpx;
}

.score-circle {
  width: 200rpx;
  height: 200rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #FFADD2, #EB2F96);
  display: flex;
  align-items: center;
  justify-content: center;
  margin: 0 auto 50rpx;
}

.score-num {
  font-size: 72rpx;
  font-weight: bold;
  color: #fff;
}

.score-unit {
  font-size: 32rpx;
  color: #fff;
  margin-left: 8rpx;
}

.complete-btns {
  display: flex;
  gap: 24rpx;
}

.complete-btn {
  flex: 1;
  height: 88rpx;
  line-height: 88rpx;
  font-size: 30rpx;
  border-radius: 44rpx;
  text-align: center;
  margin: 0;
  padding: 0;
}

.complete-btn.btn-restart {
  background: linear-gradient(135deg, #EB2F96, #FFADD2);
  color: #fff;
}

.complete-btn.btn-back {
  background: #F5F5F5;
  color: #666;
}
