/* pages/chinese/chinese.wxss */
.container {
  background: #FFF5F5;
  min-height: 100vh;
  padding-bottom: 60rpx;
}

/* Header */
.header {
  background: linear-gradient(135deg, #F5222D, #FF7A45);
  padding: 60rpx 40rpx 48rpx;
}

.header-title {
  display: block;
  font-size: 44rpx;
  font-weight: 700;
  color: #FFFFFF;
  letter-spacing: 2rpx;
}

.header-sub {
  display: block;
  font-size: 26rpx;
  color: rgba(255,255,255,0.85);
  margin-top: 10rpx;
}

/* 分区标签 */
.section-label {
  font-size: 28rpx;
  font-weight: 700;
  color: #333;
  padding: 32rpx 32rpx 16rpx;
}

.modes-label {
  padding-top: 24rpx;
}

/* 年级学期卡片 */
.section-card {
  background: #FFFFFF;
  border-radius: 24rpx;
  margin: 24rpx 24rpx 0;
  padding: 28rpx 28rpx 32rpx;
  box-shadow: 0 2rpx 16rpx rgba(245, 34, 45, 0.1);
}

.grade-row {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  margin-bottom: 24rpx;
}

.grade-btn {
  flex: 1;
  min-width: 130rpx;
  text-align: center;
  padding: 16rpx 8rpx;
  border-radius: 16rpx;
  font-size: 26rpx;
  color: #666;
  background: #FFF0F0;
  border: 2rpx solid transparent;
}

.grade-btn-active {
  color: #F5222D;
  background: #FFE7E7;
  border-color: #F5222D;
  font-weight: 700;
}

.term-row {
  display: flex;
  gap: 20rpx;
  margin-bottom: 28rpx;
}

.term-btn {
  flex: 1;
  text-align: center;
  padding: 18rpx 0;
  border-radius: 16rpx;
  font-size: 28rpx;
  color: #666;
  background: #FFF0F0;
  border: 2rpx solid transparent;
}

.term-btn-active {
  color: #F5222D;
  background: #FFE7E7;
  border-color: #F5222D;
  font-weight: 700;
}

/* 进度条 */
.progress-bar-wrap {
  margin-top: 4rpx;
}

.progress-info {
  margin-bottom: 12rpx;
}

.progress-stat-row {
  display: flex;
  align-items: center;
  justify-content: space-around;
  margin-bottom: 12rpx;
}

.progress-stat-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 4rpx;
}

.progress-stat-num {
  font-size: 40rpx;
  font-weight: bold;
  text-decoration: underline;
  text-underline-offset: 4rpx;
  text-decoration-style: dotted;
}

.progress-stat-label {
  font-size: 22rpx;
  color: #999;
}

.progress-divider {
  font-size: 30rpx;
  color: #D9D9D9;
  font-weight: bold;
}


/* 全部练习按钮 */
.all-btn-wrap {
  padding: 24rpx 24rpx 0;
}

.all-btn {
  width: 100%;
  background: linear-gradient(135deg, #FA8C16, #FF9C6E);
  color: #FFFFFF;
  border-radius: 24rpx;
  font-size: 32rpx;
  font-weight: 600;
  padding: 32rpx 0;
  border: none;
  box-shadow: 0 6rpx 20rpx rgba(250, 140, 22, 0.3);
  letter-spacing: 2rpx;
}

/* 4种玩法 */
.mode-grid {
  padding: 0 24rpx;
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.mode-card {
  display: flex;
  align-items: center;
  background: #FFFFFF;
  border-radius: 20rpx;
  padding: 24rpx 28rpx;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.05);
  gap: 20rpx;
}

.mode-icon-wrap {
  width: 88rpx;
  height: 88rpx;
  border-radius: 22rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.mode-emoji {
  font-size: 44rpx;
}

.mode-info {
  flex: 1;
}

.mode-title {
  display: block;
  font-size: 30rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 6rpx;
}

.mode-desc {
  display: block;
  font-size: 24rpx;
  color: #999;
}

.mode-arrow {
  font-size: 44rpx;
  color: #CCC;
  font-weight: 300;
}

/* 错题本入口 */
.mistake-entry {
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: #FFFFFF;
  border-radius: 20rpx;
  margin: 16rpx 24rpx 0;
  padding: 28rpx 32rpx;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.05);
}

.mistake-left {
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.mistake-icon {
  font-size: 44rpx;
}

.mistake-title {
  display: block;
  font-size: 30rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 6rpx;
}

.mistake-sub {
  display: block;
  font-size: 24rpx;
  color: #999;
}

.mistake-arrow {
  font-size: 44rpx;
  color: #CCC;
  font-weight: 300;
}

/* Footer */
.footer {
  text-align: center;
  padding: 40rpx 0 0;
}

.footer-text {
  font-size: 24rpx;
  color: #CCC;
}
