/* pages/poem/poem.wxss */
.container {
  min-height: 100vh;
  background: #F9F5FF;
  padding-bottom: 40rpx;
}

/* 顶部选择区 */
.header {
  background: linear-gradient(135deg, #9254DE, #722ED1);
  padding: 40rpx 30rpx;
  border-radius: 0 0 40rpx 40rpx;
}

.header-title {
  display: block;
  font-size: 40rpx;
  font-weight: bold;
  color: #fff;
  margin-bottom: 30rpx;
}

/* 年级选择 */
.grade-tabs {
  display: flex;
  gap: 16rpx;
  margin-bottom: 20rpx;
}

.grade-tab {
  flex: 1;
  height: 72rpx;
  line-height: 72rpx;
  text-align: center;
  background: rgba(255,255,255,0.2);
  border-radius: 36rpx;
  font-size: 28rpx;
  color: rgba(255,255,255,0.9);
  transition: all 0.3s;
}

.grade-active {
  background: #fff;
  color: #722ED1;
  font-weight: bold;
}

/* 学期选择 */
.term-tabs {
  display: flex;
  gap: 20rpx;
}

.term-tab {
  flex: 1;
  height: 64rpx;
  line-height: 64rpx;
  text-align: center;
  background: rgba(255,255,255,0.15);
  border-radius: 32rpx;
  font-size: 26rpx;
  color: rgba(255,255,255,0.85);
}

.term-active {
  background: rgba(255,255,255,0.35);
  color: #fff;
  font-weight: bold;
}

/* 统计卡片 */
.stats-card {
  background: #fff;
  margin: 30rpx;
  padding: 30rpx;
  border-radius: 24rpx;
  box-shadow: 0 4rpx 20rpx rgba(114,46,209,0.08);
}

.stats-row {
  display: flex;
  justify-content: space-around;
  margin-bottom: 24rpx;
}

.stat-item {
  text-align: center;
}

.stat-clickable {
  position: relative;
}

.stat-clickable::after {
  content: '';
  position: absolute;
  bottom: -4rpx;
  left: 50%;
  transform: translateX(-50%);
  width: 40rpx;
  height: 4rpx;
  background: #722ED1;
  border-radius: 2rpx;
  opacity: 0.4;
}

.stat-clickable .stat-num {
  text-decoration: underline;
  text-underline-offset: 4rpx;
  text-decoration-style: dotted;
}


.stat-num {
  display: block;
  font-size: 48rpx;
  font-weight: bold;
  margin-bottom: 8rpx;
}

.stat-num.purple { color: #722ED1; }
.stat-num.green { color: #52C41A; }
.stat-num.orange { color: #FA8C16; }

.stat-label {
  font-size: 24rpx;
  color: #999;
}

.progress-wrap {
  padding: 0 10rpx;
}

/* 玩法区域 */
.games-section {
  margin: 30rpx;
}

.section-title {
  display: block;
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 24rpx;
}

.games-grid {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.game-card {
  display: flex;
  align-items: center;
  background: #fff;
  padding: 30rpx;
  border-radius: 20rpx;
  border-left-width: 6rpx;
  border-left-style: solid;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.04);
}

.game-icon {
  font-size: 56rpx;
  margin-right: 24rpx;
}

.game-info {
  flex: 1;
}

.game-name {
  display: block;
  font-size: 30rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 8rpx;
}

.game-desc {
  font-size: 24rpx;
  color: #999;
}

.game-arrow {
  font-size: 40rpx;
  color: #ccc;
}

/* 错题本入口 */
.mistake-entry {
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: #fff;
  margin: 30rpx;
  padding: 30rpx;
  border-radius: 20rpx;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.04);
}

.mistake-left {
  display: flex;
  align-items: center;
}

.mistake-icon {
  font-size: 48rpx;
  margin-right: 20rpx;
}

.mistake-title {
  display: block;
  font-size: 30rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 6rpx;
}

.mistake-sub {
  font-size: 24rpx;
  color: #999;
}

.mistake-arrow {
  font-size: 40rpx;
  color: #722ED1;
}

/* 经典拓展入口 */
.classic-entry {
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: linear-gradient(135deg, #FFF7E6 0%, #FFF 100%);
  margin: 0 30rpx 30rpx;
  padding: 30rpx;
  border-radius: 20rpx;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.04);
  border: 2rpx solid #FFE7BA;
}

.classic-entry-left {
  display: flex;
  align-items: center;
}

.classic-entry-icon-wrap {
  width: 80rpx;
  height: 80rpx;
  background: linear-gradient(135deg, #FA8C16, #FFA940);
  border-radius: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 24rpx;
}

.classic-entry-icon {
  font-size: 44rpx;
}

.classic-entry-title {
  display: block;
  font-size: 30rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 6rpx;
}

.classic-entry-sub {
  font-size: 24rpx;
  color: #999;
}

.classic-entry-arrow {
  font-size: 40rpx;
  color: #FA8C16;
}

/* 诗人馆入口 */
.poets-entry {
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: linear-gradient(135deg, #4876FF0F, #722ED10F);
  border: 2rpx solid #722ED130;
  margin: 0 30rpx 40rpx;
  padding: 28rpx 30rpx;
  border-radius: 20rpx;
}

.poets-entry-left {
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.poets-entry-icon-wrap {
  width: 72rpx;
  height: 72rpx;
  background: linear-gradient(135deg, #4876FF, #722ED1);
  border-radius: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.poets-entry-icon {
  font-size: 40rpx;
}

.poets-entry-title {
  display: block;
  font-size: 30rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 6rpx;
}

.poets-entry-sub {
  font-size: 22rpx;
  color: #888;
}

.poets-entry-arrow {
  font-size: 40rpx;
  color: #722ED1;
}

