/* pages/flashcard/flashcard.wxss */
.container {
  min-height: 100vh;
  background: #F5F8FF;
  padding-bottom: 40rpx;
}

/* 顶部信息栏 */
.top-bar {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 24rpx 32rpx;
  background: #FFFFFF;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.06);
}

.back-btn {
  font-size: 30rpx;
  color: #4876FF;
  font-weight: 600;
  padding: 8rpx 0;
}

.level-tag {
  font-size: 26rpx;
  color: #666;
  background: #F0F5FF;
  padding: 8rpx 20rpx;
  border-radius: 20rpx;
}

.progress-text {
  font-size: 28rpx;
  color: #888;
  font-weight: 600;
}

/* 掌握进度条 */
.mastered-bar {
  display: flex;
  align-items: center;
  padding: 16rpx 32rpx;
  background: #FFFFFF;
  border-bottom: 1rpx solid #F0F0F0;
}

.mastered-text {
  font-size: 24rpx;
  color: #52C41A;
  font-weight: 600;
  white-space: nowrap;
}

/* 卡片区域 */
.card-area {
  padding: 40rpx 32rpx 24rpx;
}

.word-card {
  background: #FFFFFF;
  border-radius: 32rpx;
  padding: 60rpx 40rpx 48rpx;
  min-height: 480rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  box-shadow: 0 8rpx 40rpx rgba(72, 118, 255, 0.15);
  position: relative;
  border: 3rpx solid transparent;
}

.word-card.mastered-card {
  border-color: #52C41A;
  box-shadow: 0 8rpx 40rpx rgba(82, 196, 26, 0.15);
}

/* 已掌握角标 */
.mastered-badge {
  position: absolute;
  top: 24rpx;
  right: 28rpx;
  background: #52C41A;
  color: #FFFFFF;
  font-size: 22rpx;
  padding: 6rpx 16rpx;
  border-radius: 20rpx;
  font-weight: 600;
}

/* 单词 */
.word-text {
  font-size: 100rpx;
  font-weight: 800;
  color: #1a1a2e;
  letter-spacing: 4rpx;
  margin-bottom: 16rpx;
  text-align: center;
}

/* 音标 */
.phonetic-text {
  font-size: 36rpx;
  color: #888;
  margin-bottom: 40rpx;
  letter-spacing: 2rpx;
}

/* 发音按钮 */
.sound-btn {
  display: flex;
  align-items: center;
  background: #EBF5FF;
  border-radius: 40rpx;
  padding: 18rpx 40rpx;
  margin-bottom: 36rpx;
}

.sound-icon {
  font-size: 44rpx;
  margin-right: 12rpx;
}

.sound-label {
  font-size: 28rpx;
  color: #4A90D9;
  font-weight: 600;
}

/* 释义区 */
.meaning-area {
  width: 100%;
}

.meaning-area.show {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.meaning-area.hide {
  display: none;
}

.divider {
  width: 80rpx;
  height: 4rpx;
  background: #E8E8E8;
  border-radius: 4rpx;
  margin-bottom: 24rpx;
}

.meaning-text {
  font-size: 52rpx;
  font-weight: 700;
  color: #4876FF;
  text-align: center;
}

/* 翻转提示 */
.flip-hint {
  font-size: 26rpx;
  color: #CCC;
  position: absolute;
  bottom: 28rpx;
}

/* 操作按钮 */
.action-btns {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 32rpx;
  gap: 16rpx;
  margin-bottom: 24rpx;
}

.action-btn {
  border: none;
  border-radius: 20rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 24rpx 16rpx;
}

.unmast-btn {
  flex: 2;
  background: linear-gradient(135deg, #FF7875, #FF4D4F);
  box-shadow: 0 6rpx 20rpx rgba(255, 77, 79, 0.3);
}

.mast-btn {
  flex: 2;
  background: linear-gradient(135deg, #73D13D, #52C41A);
  box-shadow: 0 6rpx 20rpx rgba(82, 196, 26, 0.3);
}

.nav-btn {
  flex: 1;
  background: #FFFFFF;
  box-shadow: 0 4rpx 16rpx rgba(0,0,0,0.08);
}

.btn-icon {
  font-size: 44rpx;
  line-height: 1;
}

.btn-text {
  font-size: 24rpx;
  color: #FFFFFF;
  font-weight: 600;
  margin-top: 6rpx;
}

.nav-btn .btn-icon {
  font-size: 40rpx;
  color: #666;
}

/* 滑动提示 */
.swipe-hint {
  display: block;
  text-align: center;
  font-size: 24rpx;
  color: #CCC;
  padding: 0 32rpx;
}

/* 完成面板 */
.finished-panel {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 80rpx 40rpx;
}

.finished-emoji {
  font-size: 120rpx;
  margin-bottom: 32rpx;
}

.finished-title {
  font-size: 48rpx;
  font-weight: 800;
  color: #1a1a2e;
  margin-bottom: 16rpx;
}

.finished-sub {
  font-size: 30rpx;
  color: #888;
  margin-bottom: 60rpx;
}

.finished-btns {
  width: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 20rpx;
}
