/* pages/english/english.wxss */
.container {
  padding-bottom: 40rpx;
}

/* 顶部欢迎区 */
.header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  background: linear-gradient(135deg, #4876FF, #722ED1);
  padding: 60rpx 36rpx 48rpx;
  border-radius: 0 0 40rpx 40rpx;
  margin-bottom: 24rpx;
}

.header-left {
  display: flex;
  flex-direction: column;
}

.greeting {
  font-size: 40rpx;
  font-weight: 700;
  color: #FFFFFF;
  margin-bottom: 8rpx;
}

.sub-greeting {
  font-size: 26rpx;
  color: rgba(255,255,255,0.85);
}

.today-badge {
  background: rgba(255,255,255,0.2);
  border-radius: 20rpx;
  padding: 20rpx 28rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  backdrop-filter: blur(10px);
}

.today-num {
  font-size: 52rpx;
  font-weight: 800;
  color: #FFFFFF;
  line-height: 1;
}

.today-label {
  font-size: 22rpx;
  color: rgba(255,255,255,0.85);
  margin-top: 4rpx;
}

/* 总进度卡片 */
.total-progress-card {
  background: #FFFFFF;
  border-radius: 20rpx;
  padding: 28rpx 32rpx;
  margin: 0 24rpx 24rpx;
  box-shadow: 0 4rpx 20rpx rgba(0,0,0,0.06);
}

.progress-info {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
}

.progress-title {
  font-size: 28rpx;
  color: #555;
  font-weight: 600;
}

.progress-count {
  font-size: 28rpx;
  color: #4876FF;
  font-weight: 700;
}

/* 段落标题 */
.section-title {
  font-size: 30rpx;
  font-weight: 700;
  color: #333;
  padding: 8rpx 32rpx 16rpx;
}

/* 级别网格 */
.level-grid {
  padding: 0 24rpx;
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  margin-bottom: 16rpx;
}

.level-card {
  background: #FFFFFF;
  border-radius: 20rpx;
  padding: 20rpx 24rpx;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.05);
  transition: all 0.2s;
}

.level-card.selected {
  box-shadow: 0 4rpx 20rpx rgba(72, 118, 255, 0.2);
  transform: scale(1.01);
}

.level-header {
  display: flex;
  align-items: center;
  border-radius: 12rpx;
  padding: 16rpx 16rpx;
  margin-bottom: 12rpx;
  border: 2rpx solid transparent;
}

.level-emoji {
  font-size: 44rpx;
  margin-right: 20rpx;
}

.level-name-wrap {
  flex: 1;
  display: flex;
  flex-direction: column;
}

.level-name {
  font-size: 30rpx;
  font-weight: 700;
  color: #222;
}

.level-desc {
  font-size: 22rpx;
  color: #888;
  margin-top: 2rpx;
}

.level-count {
  font-size: 26rpx;
  font-weight: 700;
}

/* 模式按钮区 */
.mode-section {
  padding: 0 24rpx;
  margin-bottom: 24rpx;
}

.mode-btns {
  display: flex;
  gap: 20rpx;
  margin-bottom: 32rpx;
}

.mode-btn {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 36rpx 20rpx;
  border-radius: 24rpx;
  border: none;
  box-shadow: 0 6rpx 20rpx rgba(0,0,0,0.1);
}

.flashcard-btn {
  background: linear-gradient(135deg, #4876FF, #722ED1);
}

.spelling-btn {
  background: linear-gradient(135deg, #52C41A, #95DE64);
}

.mode-icon {
  font-size: 56rpx;
  margin-bottom: 12rpx;
}

.mode-name {
  font-size: 32rpx;
  font-weight: 700;
  color: #FFFFFF;
  margin-bottom: 4rpx;
}

.mode-desc {
  font-size: 22rpx;
  color: rgba(255,255,255,0.85);
}

.all-btn {
  width: 100%;
  background: linear-gradient(135deg, #FA8C16, #FFA940);
  color: #FFFFFF;
  border-radius: 24rpx;
  font-size: 32rpx;
  font-weight: 600;
  padding: 32rpx 0;
  border: none;
  box-shadow: 0 6rpx 20rpx rgba(250, 140, 22, 0.3);
  letter-spacing: 2rpx;
}

/* 快捷入口卡片 */
.quick-entry {
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: #FFFFFF;
  border-radius: 20rpx;
  margin: 16rpx 24rpx 0;
  padding: 28rpx 32rpx;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.05);
}

.quick-entry-left {
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.quick-entry-icon {
  font-size: 44rpx;
}

.quick-entry-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #333;
  display: block;
  margin-bottom: 6rpx;
}

.quick-entry-sub {
  font-size: 24rpx;
  color: #999;
  display: block;
}

.quick-entry-arrow {
  font-size: 40rpx;
  color: #CCC;
  font-weight: 300;
}

