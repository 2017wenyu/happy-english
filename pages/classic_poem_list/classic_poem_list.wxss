/* pages/classic_poem_list/classic_poem_list.wxss */

.container {
  min-height: 100vh;
  background: #F5F8FF;
}

/* 顶部诗人信息 */
.poet-header {
  display: flex;
  align-items: center;
  padding: 40rpx 32rpx;
  position: relative;
}

.poet-avatar-wrap {
  width: 120rpx;
  height: 120rpx;
  background: rgba(255, 255, 255, 0.2);
  border-radius: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 24rpx;
}

.poet-avatar {
  font-size: 60rpx;
}

.poet-info {
  flex: 1;
}

.poet-name {
  display: block;
  font-size: 40rpx;
  font-weight: bold;
  color: #fff;
  margin-bottom: 8rpx;
}

.poet-title {
  display: inline-block;
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.9);
  background: rgba(255, 255, 255, 0.2);
  padding: 4rpx 16rpx;
  border-radius: 12rpx;
  margin-right: 12rpx;
}

.poet-dynasty {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.8);
}

.poem-count {
  text-align: center;
  background: rgba(255, 255, 255, 0.2);
  padding: 16rpx 28rpx;
  border-radius: 16rpx;
}

.count-num {
  display: block;
  font-size: 48rpx;
  font-weight: bold;
  color: #fff;
  line-height: 1;
}

.count-label {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.8);
}

/* 诗词列表 */
.poem-list {
  padding: 24rpx 32rpx;
}

.poem-card {
  display: flex;
  align-items: center;
  background: #fff;
  border-radius: 20rpx;
  padding: 28rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.06);
}

.poem-card.mastered {
  opacity: 0.7;
}

/* 序号 */
.poem-index {
  width: 56rpx;
  height: 56rpx;
  background: linear-gradient(135deg, #722ED1, #531DAB);
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  font-weight: bold;
  color: #fff;
  margin-right: 24rpx;
  flex-shrink: 0;
}

/* 内容 */
.poem-body {
  flex: 1;
  min-width: 0;
}

.poem-title-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 8rpx;
}

.poem-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
}

.poem-type-tag {
  font-size: 20rpx;
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
}

.poem-type-tag.shi {
  background: #E6F7FF;
  color: #1890FF;
}

.poem-type-tag.ci {
  background: #F6FFED;
  color: #52C41A;
}

.poem-preview {
  display: block;
  font-size: 26rpx;
  color: #666;
  line-height: 1.5;
  margin-bottom: 8rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.poem-info {
  font-size: 22rpx;
  color: #999;
}

/* 掌握按钮 */
.mastered-btn {
  width: 64rpx;
  height: 64rpx;
  border-radius: 32rpx;
  background: #f5f5f5;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-left: 16rpx;
  flex-shrink: 0;
  font-size: 32rpx;
  color: #ccc;
}

.mastered-btn.done {
  background: #52C41A;
  color: #fff;
}

/* 空状态 */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 120rpx 32rpx;
}

.empty-icon {
  font-size: 80rpx;
  margin-bottom: 24rpx;
}

.empty-text {
  font-size: 28rpx;
  color: #999;
}
