<!--pages/mistakes/mistakes.wxml-->
<view class="container">
  <!-- 页头 -->
  <view class="page-header" style="background: {{subjectConfig.gradient}}">
    <view class="header-info">
      <text class="header-title">{{subjectConfig.icon}} {{subjectConfig.title}}</text>
      <text class="header-count" wx:if="{{!isEmpty}}">共 {{wrongWordList.length}} 个需要复习</text>
      <text class="header-count" wx:if="{{isEmpty}}">全部掌握，继续加油！</text>
    </view>
    <view class="clear-btn" bindtap="clearAll" wx:if="{{!isEmpty}}">清空</view>
  </view>

  <!-- 操作按钮（英语学科才显示）-->
  <view class="action-btns" wx:if="{{!isEmpty && subject === 'english'}}">
    <button class="review-btn flashcard-btn" bindtap="reviewAllMistakes">
      🃏 闪卡复习错题
    </button>
    <button class="review-btn spell-btn" bindtap="spellMistakes">
      ✏️ 默写错题
    </button>
  </view>

  <!-- 空状态 -->
  <view class="empty-state" wx:if="{{isEmpty}}">
    <text class="empty-emoji">🎉</text>
    <text class="empty-title">错题本是空的！</text>
    <text class="empty-desc">太棒了，没有错题。继续保持！</text>
  </view>

  <!-- 英语错题列表 -->
  <view class="word-list" wx:if="{{!isEmpty && subject === 'english'}}">
    <view
      class="word-item"
      wx:for="{{wrongWordList}}"
      wx:key="id"
    >
      <view class="word-main">
        <view class="word-left">
          <view class="level-dot" style="background: {{item.levelColor}}"></view>
          <view class="word-info">
            <text class="word-text">{{item.word}}</text>
            <text class="phonetic-text">{{item.phonetic}}</text>
          </view>
        </view>
        <view class="word-right">
          <text class="meaning-text">{{item.meaning}}</text>
          <text class="level-label" style="color: {{item.levelColor}}">{{item.levelName}}</text>
        </view>
      </view>
      <view class="word-actions">
        <view class="action-sound" catchtap="playSound" data-word="{{item.word}}">
          🔊 发音
        </view>
        <view class="action-mastered" catchtap="markMastered" data-id="{{item.id}}">
          ✓ 已掌握
        </view>
      </view>
    </view>
  </view>

  <!-- 汉字错题列表 -->
  <view class="word-list" wx:if="{{!isEmpty && subject === 'chinese'}}">
    <view
      class="word-item cn-word-item"
      wx:for="{{wrongWordList}}"
      wx:key="id"
    >
      <view class="word-main">
        <view class="word-left">
          <view class="cn-char-wrap">
            <text class="cn-char">{{item.word}}</text>
          </view>
          <view class="word-info">
            <text class="cn-pinyin">{{item.pinyin}}</text>
            <text class="cn-group">{{item.group[0]}}、{{item.group[1]}}</text>
          </view>
        </view>
        <view class="word-right">
          <text class="wrong-count-label" wx:if="{{item.wrongCount > 1}}">错{{item.wrongCount}}次</text>
        </view>
      </view>
      <view class="word-actions">
        <view class="action-mastered" catchtap="markMastered" data-id="{{item.id}}">
          ✓ 已掌握
        </view>
      </view>
    </view>
  </view>

  <!-- 古诗错题列表 -->
  <view class="word-list" wx:if="{{!isEmpty && subject === 'poem'}}">
    <view
      class="word-item poem-item"
      wx:for="{{wrongWordList}}"
      wx:key="id"
    >
      <view class="word-main">
        <view class="word-left">
          <view class="poem-info">
            <text class="poem-title">{{item.title}}</text>
            <text class="poem-author">[{{item.dynasty}}] {{item.author}}</text>
          </view>
        </view>
        <view class="word-right">
          <text class="wrong-count-label" wx:if="{{item.wrongCount > 1}}">错{{item.wrongCount}}次</text>
        </view>
      </view>
      <view class="poem-content">
        <text wx:for="{{item.content}}" wx:key="index" wx:for-item="line">{{line}}</text>
      </view>
      <view class="word-actions">
        <view class="action-mastered" catchtap="markMastered" data-id="{{item.id}}">
          ✓ 已掌握
        </view>
      </view>
    </view>
  </view>
</view>
