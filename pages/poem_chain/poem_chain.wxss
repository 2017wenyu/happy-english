/* pages/poem_chain/poem_chain.wxss */
.container {
  min-height: 100vh;
  background: #F9F5FF;
  padding: 30rpx;
}

/* 开始卡片 */
.start-card {
  background: #fff;
  border-radius: 24rpx;
  padding: 60rpx 40rpx;
  text-align: center;
  box-shadow: 0 4rpx 20rpx rgba(114,46,209,0.08);
}

.start-icon {
  font-size: 80rpx;
  display: block;
  margin-bottom: 20rpx;
}

.start-title {
  display: block;
  font-size: 48rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 16rpx;
}

.start-desc {
  display: block;
  font-size: 26rpx;
  color: #666;
  margin-bottom: 40rpx;
  line-height: 1.6;
}

.mode-btns {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
  margin-bottom: 30rpx;
}

.mode-btn {
  height: 96rpx;
  line-height: 96rpx;
  background: linear-gradient(135deg, #9254DE, #722ED1);
  color: #fff;
  font-size: 32rpx;
  border-radius: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.btn-icon {
  margin-right: 12rpx;
}

.back-btn {
  height: 80rpx;
  line-height: 80rpx;
  background: #F5F5F5;
  color: #666;
  font-size: 28rpx;
  border-radius: 40rpx;
  text-align: center;
  margin: 0;
  padding: 0;
}

/* 游戏卡片 */
.game-card {
  background: #fff;
  border-radius: 24rpx;
  padding: 30rpx;
  box-shadow: 0 4rpx 20rpx rgba(114,46,209,0.08);
}

.score-bar {
  display: flex;
  justify-content: space-between;
  margin-bottom: 30rpx;
}

.score-text, .chain-text {
  font-size: 28rpx;
  color: #722ED1;
  font-weight: bold;
}

/* 当前诗句 */
.current-line-box {
  background: #F9F5FF;
  border-radius: 16rpx;
  padding: 30rpx;
  text-align: center;
  margin-bottom: 30rpx;
}

.line-label {
  display: block;
  font-size: 24rpx;
  color: #999;
  margin-bottom: 12rpx;
}

.line-text {
  display: block;
  font-size: 36rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 12rpx;
  line-height: 1.6;
}

.line-poem {
  display: block;
  font-size: 24rpx;
  color: #666;
  margin-bottom: 16rpx;
}

.last-char {
  display: inline-block;
  background: #722ED1;
  color: #fff;
  font-size: 28rpx;
  padding: 8rpx 24rpx;
  border-radius: 24rpx;
}

/* 历史记录 */
.history-box {
  max-height: 300rpx;
  background: #F5F5F5;
  border-radius: 16rpx;
  padding: 20rpx;
  margin-bottom: 30rpx;
}

.history-title {
  display: block;
  font-size: 24rpx;
  color: #999;
  margin-bottom: 16rpx;
}

.history-item {
  padding: 12rpx 0;
  border-bottom: 1rpx solid #E8E8E8;
}

.history-line {
  display: block;
  font-size: 28rpx;
  color: #333;
}

.history-poem {
  font-size: 22rpx;
  color: #999;
}

/* 输入区 */
.input-area {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 20rpx;
}

.chain-input {
  flex: 1;
  height: 80rpx;
  min-height: 80rpx;
  background: #F5F5F5;
  border-radius: 40rpx;
  padding: 0 30rpx;
  font-size: 28rpx;
  box-sizing: border-box;
}

.submit-btn {
  width: 140rpx;
  height: 80rpx;
  line-height: 80rpx;
  background: linear-gradient(135deg, #9254DE, #722ED1);
  color: #fff;
  font-size: 28rpx;
  border-radius: 40rpx;
  margin: 0;
  padding: 0;
}

/* 提示 */
.hint-box {
  background: #FFFBE6;
  padding: 20rpx;
  border-radius: 12rpx;
  margin-bottom: 20rpx;
}

.hint-text {
  font-size: 26rpx;
  color: #D48806;
}

.hint-btn {
  height: 64rpx;
  line-height: 64rpx;
  background: #FFFBE6;
  color: #D48806;
  font-size: 26rpx;
  border-radius: 32rpx;
  margin-bottom: 20rpx;
}

/* 完成卡片 */
.complete-card {
  background: #fff;
  border-radius: 24rpx;
  padding: 80rpx 40rpx;
  text-align: center;
  box-shadow: 0 4rpx 20rpx rgba(114,46,209,0.08);
}

.complete-icon {
  font-size: 100rpx;
  display: block;
  margin-bottom: 20rpx;
}

.complete-title {
  display: block;
  font-size: 48rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 16rpx;
}

.complete-sub {
  display: block;
  font-size: 28rpx;
  color: #666;
  margin-bottom: 50rpx;
}

.complete-btns {
  display: flex;
  gap: 24rpx;
}

.complete-btn {
  flex: 1;
  height: 88rpx;
  line-height: 88rpx;
  font-size: 30rpx;
  border-radius: 44rpx;
  text-align: center;
  margin: 0;
  padding: 0;
}

.complete-btn.btn-restart {
  background: linear-gradient(135deg, #9254DE, #722ED1);
  color: #fff;
}

.complete-btn.btn-back {
  background: #F5F5F5;
  color: #666;
}
