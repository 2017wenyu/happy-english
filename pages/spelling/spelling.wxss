/* pages/spelling/spelling.wxss */
.container {
  min-height: 100vh;
  background: #F5F8FF;
  padding-bottom: 60rpx;
}

/* 顶部状态栏 */
.top-bar {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 24rpx 32rpx;
  background: #FFFFFF;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.06);
}

.back-btn {
  font-size: 30rpx;
  color: #4876FF;
  font-weight: 600;
}

.score-row {
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.score-item {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.score-num {
  font-size: 36rpx;
  font-weight: 800;
  line-height: 1;
}

.score-label {
  font-size: 20rpx;
  margin-top: 2rpx;
}

.score-item.correct .score-num { color: #52C41A; }
.score-item.correct .score-label { color: #52C41A; }
.score-item.wrong .score-num { color: #FF4D4F; }
.score-item.wrong .score-label { color: #FF4D4F; }

.combo-badge {
  background: linear-gradient(135deg, #FA8C16, #FAAD14);
  color: #FFFFFF;
  font-size: 22rpx;
  font-weight: 700;
  padding: 6rpx 16rpx;
  border-radius: 20rpx;
}

.progress-text {
  font-size: 26rpx;
  color: #888;
}

/* 题目卡片 */
.question-card {
  background: #FFFFFF;
  border-radius: 32rpx;
  margin: 32rpx 24rpx 24rpx;
  padding: 48rpx 40rpx;
  box-shadow: 0 8rpx 32rpx rgba(72, 118, 255, 0.12);
  display: flex;
  flex-direction: column;
  align-items: center;
}

/* 播放区域 */
.play-area {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-bottom: 36rpx;
}

.play-btn {
  width: 140rpx;
  height: 140rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #4876FF, #722ED1);
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 8rpx 30rpx rgba(72, 118, 255, 0.4);
  margin-bottom: 16rpx;
}

.play-icon {
  font-size: 64rpx;
}

.play-label {
  font-size: 26rpx;
  color: #888;
}

/* 翻译提示 */
.meaning-row {
  margin-bottom: 16rpx;
}

.meaning-text {
  font-size: 32rpx;
  font-weight: 600;
  color: #1a1a2e;
  background: linear-gradient(135deg, #FFF7E6, #FFFBE6);
  padding: 16rpx 32rpx;
  border-radius: 20rpx;
  border: 2rpx solid #FFD591;
}

/* 音标切换 */
.phonetic-row {
  margin-bottom: 16rpx;
}

.phonetic-toggle {
  font-size: 28rpx;
  color: #4A90D9;
  background: #EBF5FF;
  padding: 12rpx 28rpx;
  border-radius: 24rpx;
}

/* 首字母提示 */
.hint-row {
  margin-bottom: 16rpx;
}

.hint-text {
  font-size: 30rpx;
  color: #FA8C16;
  font-weight: 600;
  letter-spacing: 4rpx;
}

/* 长度提示 */
.length-hint {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 16rpx;
}

.length-text {
  font-size: 26rpx;
  color: #AAA;
}

.letter-dots {
  display: flex;
  gap: 12rpx;
}

.letter-dot {
  width: 28rpx;
  height: 8rpx;
  background: #D0D0D0;
  border-radius: 4rpx;
}

/* 结果横幅 */
.result-banner {
  display: flex;
  align-items: center;
  margin: 0 24rpx 24rpx;
  padding: 28rpx 32rpx;
  border-radius: 24rpx;
  gap: 24rpx;
}

.result-correct {
  background: linear-gradient(135deg, #F6FFED, #D9F7BE);
  border: 2rpx solid #52C41A;
}

.result-wrong {
  background: linear-gradient(135deg, #FFF2F0, #FFCCC7);
  border: 2rpx solid #FF4D4F;
}

.result-icon {
  font-size: 64rpx;
}

.result-info {
  display: flex;
  flex-direction: column;
}

.result-title {
  font-size: 28rpx;
  color: #555;
  margin-bottom: 8rpx;
}

.result-word {
  font-size: 52rpx;
  font-weight: 800;
  color: #52C41A;
  letter-spacing: 4rpx;
}

.result-word-wrong {
  font-size: 52rpx;
  font-weight: 800;
  color: #FF4D4F;
  letter-spacing: 4rpx;
}

.result-meaning {
  font-size: 28rpx;
  color: #888;
  margin-top: 4rpx;
}

/* 输入区域 - 纵向排列 */
.input-area {
  margin: 0 24rpx 24rpx;
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.spell-input {
  background: #FFFFFF;
  border: 3rpx solid #D0E4F7;
  border-radius: 20rpx;
  padding: 24rpx 32rpx;
  font-size: 32rpx;
  font-weight: 600;
  color: #1a1a2e;
  letter-spacing: 2rpx;
  box-shadow: 0 2rpx 12rpx rgba(74, 144, 217, 0.1);
}

.spell-input:focus {
  border-color: #4876FF;
}

.submit-btn {
  background: linear-gradient(135deg, #FA8C16, #FFA940);
  color: #FFFFFF;
  border-radius: 20rpx;
  font-size: 30rpx;
  font-weight: 700;
  padding: 24rpx 0;
  border: none;
  box-shadow: 0 6rpx 20rpx rgba(250, 140, 22, 0.35);
}

/* 辅助按钮 */
.helper-btn {
  border-radius: 20rpx;
  font-size: 28rpx;
  font-weight: 600;
  padding: 22rpx 0;
  border: none;
}

.hint-btn {
  background: #FFF7E6;
  color: #FA8C16;
  border: 2rpx solid #FFD591;
}

.skip-btn {
  background: #F5F5F5;
  color: #888;
}

/* 完成面板 */
.finished-panel {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 80rpx 40rpx;
}

.finished-emoji {
  font-size: 120rpx;
  margin-bottom: 28rpx;
}

.finished-title {
  font-size: 48rpx;
  font-weight: 800;
  color: #1a1a2e;
  margin-bottom: 36rpx;
}

.result-stats {
  display: flex;
  align-items: center;
  gap: 32rpx;
  margin-bottom: 28rpx;
}

.stat-item {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.stat-num {
  font-size: 72rpx;
  font-weight: 900;
  line-height: 1;
}

.stat-label {
  font-size: 26rpx;
  margin-top: 8rpx;
}

.stat-correct .stat-num { color: #52C41A; }
.stat-correct .stat-label { color: #52C41A; }
.stat-wrong .stat-num { color: #FF4D4F; }
.stat-wrong .stat-label { color: #FF4D4F; }

.stat-divider {
  font-size: 60rpx;
  color: #DDD;
}

.finished-sub {
  font-size: 30rpx;
  color: #888;
  text-align: center;
  margin-bottom: 60rpx;
}

.finished-btns {
  width: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
}
