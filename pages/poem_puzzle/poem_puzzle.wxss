/* pages/poem_puzzle/poem_puzzle.wxss */
.container {
  min-height: 100vh;
  background: #FFF7E6;
  padding: 30rpx;
}

/* 游戏卡片 */
.game-card {
  background: #fff;
  border-radius: 24rpx;
  padding: 30rpx;
  box-shadow: 0 4rpx 20rpx rgba(250,140,22,0.08);
}

.progress-text {
  display: block;
  text-align: center;
  font-size: 24rpx;
  color: #999;
  margin-bottom: 20rpx;
}

.poem-header {
  text-align: center;
  margin-bottom: 24rpx;
}

.poem-title {
  display: block;
  font-size: 40rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 8rpx;
}

.poem-author {
  font-size: 24rpx;
  color: #999;
}

/* 提示 */
.hint-box {
  display: flex;
  align-items: center;
  background: #FFFBE6;
  padding: 20rpx;
  border-radius: 12rpx;
  margin-bottom: 24rpx;
}

.hint-icon {
  font-size: 32rpx;
  margin-right: 12rpx;
}

.hint-text {
  font-size: 26rpx;
  color: #D48806;
}

/* 区域标题 */
.area-title {
  display: block;
  font-size: 26rpx;
  color: #666;
  margin-bottom: 16rpx;
}

/* 答案区 */
.answer-area {
  margin-bottom: 30rpx;
}

.answer-lines {
  background: #F5F5F5;
  border-radius: 16rpx;
  padding: 20rpx;
  min-height: 160rpx;
}

.answer-line {
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: #fff;
  padding: 20rpx 24rpx;
  margin-bottom: 12rpx;
  border-radius: 12rpx;
  font-size: 30rpx;
  color: #333;
  border: 2rpx solid #E8E8E8;
}

.answer-line.correct {
  background: #F6FFED;
  border-color: #52C41A;
}

.answer-line.wrong {
  background: #FFF1F0;
  border-color: #FF4D4F;
  animation: shake 0.5s;
}

@keyframes shake {
  0%, 100% { transform: translateX(0); }
  25% { transform: translateX(-10rpx); }
  75% { transform: translateX(10rpx); }
}

.remove-icon {
  font-size: 24rpx;
  color: #999;
}

.answer-placeholder {
  text-align: center;
  padding: 40rpx;
  color: #999;
  font-size: 26rpx;
}

/* 选项区 */
.options-area {
  margin-bottom: 30rpx;
}

.option-lines {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.option-line {
  background: #FFF7E6;
  padding: 24rpx;
  border-radius: 12rpx;
  text-align: center;
  font-size: 30rpx;
  color: #333;
  border: 2rpx solid #FFD591;
  transition: all 0.3s;
}

.option-line.selected {
  opacity: 0.4;
  background: #F5F5F5;
  border-color: #D9D9D9;
}

.option-line:active {
  transform: scale(0.98);
}

/* 操作按钮 */
.action-btns {
  display: flex;
  gap: 20rpx;
}

.action-btn {
  flex: 1;
  height: 80rpx;
  line-height: 80rpx;
  font-size: 28rpx;
  border-radius: 40rpx;
  text-align: center;
  margin: 0;
  padding: 0;
}

.btn-reset {
  background: #F5F5F5;
  color: #666;
}

.btn-skip {
  background: #FFF7E6;
  color: #FA8C16;
  border: 2rpx solid #FFD591;
}

.btn-mark {
  background: #FFF1F0;
  color: #FF4D4F;
  border: 2rpx solid #FFA39E;
}

.btn-back {
  background: linear-gradient(135deg, #FA8C16, #FFA940);
  color: #fff;
}

/* 完成卡片 */
.complete-card {
  background: #fff;
  border-radius: 24rpx;
  padding: 80rpx 40rpx;
  text-align: center;
  box-shadow: 0 4rpx 20rpx rgba(250,140,22,0.08);
}

.complete-icon {
  font-size: 100rpx;
  display: block;
  margin-bottom: 20rpx;
}

.complete-title {
  display: block;
  font-size: 48rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 16rpx;
}

.complete-sub {
  display: block;
  font-size: 28rpx;
  color: #666;
  margin-bottom: 50rpx;
}

.complete-btns {
  display: flex;
  gap: 24rpx;
}

.complete-btn {
  flex: 1;
  height: 88rpx;
  line-height: 88rpx;
  font-size: 30rpx;
  border-radius: 44rpx;
  text-align: center;
  margin: 0;
  padding: 0;
}

.complete-btn.btn-restart {
  background: linear-gradient(135deg, #FA8C16, #FFA940);
  color: #fff;
}

.complete-btn.btn-back {
  background: #F5F5F5;
  color: #666;
}
