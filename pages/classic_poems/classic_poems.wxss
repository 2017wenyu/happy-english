/* pages/classic_poems/classic_poems.wxss */

.container {
  min-height: 100vh;
  background: #F5F8FF;
  padding-bottom: 40rpx;
}

/* 顶部 banner */
.banner {
  background: linear-gradient(135deg, #722ED1 0%, #531DAB 100%);
  padding: 60rpx 32rpx 80rpx;
  text-align: center;
  position: relative;
}

.banner-title {
  display: block;
  font-size: 48rpx;
  font-weight: bold;
  color: #fff;
  margin-bottom: 16rpx;
}

.banner-sub {
  display: block;
  font-size: 28rpx;
  color: rgba(255, 255, 255, 0.8);
  margin-bottom: 20rpx;
}

.banner-stats {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 16rpx;
}

.stats-item {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.7);
  background: rgba(255, 255, 255, 0.15);
  padding: 8rpx 20rpx;
  border-radius: 24rpx;
}

.stats-dot {
  color: rgba(255, 255, 255, 0.5);
}

/* 筛选 */
.filter-scroll {
  width: 100%;
  white-space: nowrap;
  background: #fff;
  border-bottom: 1rpx solid #f0f0f0;
}

.filter-row {
  display: inline-flex;
  align-items: center;
  gap: 16rpx;
  padding: 24rpx 32rpx;
}

.filter-tag {
  padding: 12rpx 32rpx;
  border-radius: 32rpx;
  font-size: 28rpx;
  color: #666;
  background: #f5f5f5;
  transition: all 0.2s;
}

.filter-tag.active {
  background: #722ED1;
  color: #fff;
  font-weight: 500;
}

/* 诗人列表 */
.poet-list {
  padding: 24rpx 32rpx;
}

.poet-card {
  display: flex;
  align-items: center;
  background: #fff;
  border-radius: 24rpx;
  padding: 28rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.06);
}

/* 头像区域 */
.poet-avatar-wrap {
  width: 120rpx;
  height: 120rpx;
  border-radius: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  position: relative;
  flex-shrink: 0;
  margin-right: 24rpx;
}

.poet-avatar {
  font-size: 56rpx;
}

.poet-dynasty-badge {
  position: absolute;
  bottom: -8rpx;
  right: -8rpx;
  background: #fff;
  padding: 4rpx 12rpx;
  border-radius: 12rpx;
  font-size: 20rpx;
  color: #666;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.1);
  font-weight: 500;
}

/* 诗人信息 */
.poet-info {
  flex: 1;
  min-width: 0;
}

.poet-header-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 8rpx;
}

.poet-name {
  font-size: 36rpx;
  font-weight: bold;
  color: #333;
}

.poet-title-tag {
  font-size: 22rpx;
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
  border: 1rpx solid;
}

.poet-bio-preview {
  display: block;
  font-size: 26rpx;
  color: #666;
  line-height: 1.5;
  margin-bottom: 12rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
}

.poet-works-row {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.poet-works-label {
  font-size: 24rpx;
  color: #999;
}

.poet-works-count {
  font-size: 26rpx;
  font-weight: 500;
}

/* 右箭头 */
.arrow {
  font-size: 40rpx;
  color: #ccc;
  margin-left: 16rpx;
}
