/* pages/poem_write/poem_write.wxss */
.container {
  min-height: 100vh;
  background: #E6FFFB;
  padding: 30rpx;
}

/* 游戏卡片 */
.game-card {
  background: #fff;
  border-radius: 24rpx;
  padding: 30rpx;
  box-shadow: 0 4rpx 20rpx rgba(19,194,194,0.08);
}

.progress-text {
  display: block;
  text-align: center;
  font-size: 24rpx;
  color: #999;
  margin-bottom: 20rpx;
}

.poem-header {
  text-align: center;
  margin-bottom: 30rpx;
}

.poem-title {
  display: block;
  font-size: 40rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 8rpx;
}

.poem-author {
  font-size: 24rpx;
  color: #999;
}

/* 填空区域 */
.fill-area {
  background: #F5F5F5;
  border-radius: 16rpx;
  padding: 30rpx;
  margin-bottom: 30rpx;
}

.poem-lines {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.poem-line {
  display: flex;
  flex-wrap: wrap;
  justify-content: center;
  gap: 4rpx;
  font-size: 36rpx;
  line-height: 1.8;
}

.poem-char {
  color: #333;
}

.poem-char.punct {
  color: #999;
}

/* 填空框 */
.blank-box {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: 64rpx;
  height: 64rpx;
  border: 2rpx solid #13C2C2;
  border-radius: 8rpx;
  background: #fff;
  margin: 0 4rpx;
  cursor: pointer;
}

.blank-box.selected {
  border-color: #FA8C16;
  border-width: 4rpx;
  box-shadow: 0 0 12rpx rgba(250, 140, 22, 0.4);
}

.blank-box.correct {
  border-color: #52C41A;
  background: #F6FFED;
}

.blank-box.wrong {
  border-color: #FF4D4F;
  background: #FFF1F0;
}

.blank-text {
  font-size: 36rpx;
  color: #333;
}

/* 字库区域 */
.char-bank-area {
  margin-top: 30rpx;
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx;
  border: 2rpx solid #E8E8E8;
}

.char-bank-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}

.char-bank-title {
  font-size: 26rpx;
  color: #666;
}

.char-bank-clear {
  font-size: 24rpx;
  color: #FF4D4F;
  padding: 8rpx 16rpx;
  border-radius: 8rpx;
  background: #FFF1F0;
}

.char-bank {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  justify-content: center;
}

.char-bank-item {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 72rpx;
  height: 72rpx;
  background: #F5F5F5;
  border-radius: 12rpx;
  font-size: 36rpx;
  color: #333;
  cursor: pointer;
  transition: all 0.2s;
}

.char-bank-item:active {
  background: #13C2C2;
  color: #fff;
  transform: scale(0.95);
}

.char-bank-item.used {
  opacity: 0.4;
  background: #E8E8E8;
}

/* 全篇输入区域 */
.full-area {
  margin-bottom: 30rpx;
}

.full-input {
  width: 100%;
  height: 400rpx;
  background: #F5F5F5;
  border-radius: 16rpx;
  padding: 24rpx;
  font-size: 30rpx;
  line-height: 1.8;
  box-sizing: border-box;
}

/* 答案展示 */
.answer-show {
  background: #F6FFED;
  border: 2rpx solid #B7EB8F;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 30rpx;
}

.answer-title {
  display: block;
  font-size: 28rpx;
  font-weight: bold;
  color: #52C41A;
  margin-bottom: 16rpx;
}

.answer-content {
  margin-bottom: 16rpx;
}

.answer-line {
  display: block;
  font-size: 30rpx;
  color: #333;
  line-height: 1.8;
}

.score-text {
  display: block;
  font-size: 32rpx;
  font-weight: bold;
  color: #52C41A;
  text-align: center;
}

/* 按钮区域 */
.btn-area {
  margin-top: 30rpx;
}

.submit-btn, .next-btn, .restart-btn, .back-btn {
  width: 100%;
  height: 88rpx;
  line-height: 88rpx;
  font-size: 30rpx;
  border-radius: 44rpx;
  text-align: center;
  margin: 0 0 20rpx 0;
  padding: 0;
}

.submit-btn {
  background: linear-gradient(135deg, #13C2C2, #36CFC9);
  color: #fff;
}

.next-btn {
  background: linear-gradient(135deg, #FA8C16, #FFA940);
  color: #fff;
}

.restart-btn {
  background: linear-gradient(135deg, #13C2C2, #36CFC9);
  color: #fff;
  margin-bottom: 20rpx;
}

.back-btn {
  background: #F5F5F5;
  color: #666;
}

/* 操作按钮 */
.action-btns {
  display: flex;
  gap: 20rpx;
}

.action-btn {
  flex: 1;
  height: 88rpx;
  line-height: 88rpx;
  font-size: 30rpx;
  border-radius: 44rpx;
  text-align: center;
  margin: 0;
  padding: 0;
}

.btn-submit {
  background: linear-gradient(135deg, #13C2C2, #36CFC9);
  color: #fff;
}

.btn-next {
  background: linear-gradient(135deg, #FA8C16, #FFA940);
  color: #fff;
}

.btn-back {
  background: #F5F5F5;
  color: #666;
}

/* 完成卡片 */
.complete-card {
  background: #fff;
  border-radius: 24rpx;
  padding: 80rpx 40rpx;
  text-align: center;
  box-shadow: 0 4rpx 20rpx rgba(19,194,194,0.08);
}

.complete-icon {
  font-size: 100rpx;
  display: block;
  margin-bottom: 20rpx;
}

.complete-title {
  display: block;
  font-size: 48rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 16rpx;
}

.complete-sub {
  display: block;
  font-size: 28rpx;
  color: #666;
  margin-bottom: 50rpx;
}

.complete-btns {
  display: flex;
  gap: 24rpx;
}

.complete-btn {
  flex: 1;
  height: 88rpx;
  line-height: 88rpx;
  font-size: 30rpx;
  border-radius: 44rpx;
  text-align: center;
  margin: 0;
  padding: 0;
}

.complete-btn.btn-restart {
  background: linear-gradient(135deg, #13C2C2, #36CFC9);
  color: #fff;
}

.complete-btn.btn-back {
  background: #F5F5F5;
  color: #666;
}
