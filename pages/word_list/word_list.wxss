/* pages/word_list/word_list.wxss */
.container {
  min-height: 100vh;
  background: #F5F8FF;
  padding-bottom: 40rpx;
}

/* 顶部统计栏 */
.top-bar {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 24rpx 32rpx;
  background: #fff;
  border-bottom: 1rpx solid #F0F0F0;
}

.top-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #222;
}

.top-count {
  font-size: 26rpx;
  color: #888;
}

/* 空状态 */
.empty-box {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 120rpx 40rpx;
}

.empty-icon {
  font-size: 80rpx;
  margin-bottom: 24rpx;
}

.empty-text {
  font-size: 32rpx;
  color: #555;
  margin-bottom: 12rpx;
}

.empty-sub {
  font-size: 26rpx;
  color: #aaa;
  text-align: center;
}

/* ===== 古诗卡片 ===== */
.poem-card {
  display: flex;
  align-items: center;
  background: #fff;
  margin: 16rpx 24rpx 0;
  border-radius: 20rpx;
  padding: 24rpx 20rpx;
  gap: 16rpx;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.05);
}

.mastered-dot {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.dot-mastered {
  background: #F6FFED;
  border: 2rpx solid #52C41A;
}

.dot-unmastered {
  background: #F5F5F5;
  border: 2rpx solid #D9D9D9;
}

.dot-icon {
  font-size: 28rpx;
  color: #52C41A;
}

.dot-unmastered .dot-icon {
  color: #BFBFBF;
}

.poem-info {
  flex: 1;
  min-width: 0;
}

.poem-header-row {
  display: flex;
  align-items: baseline;
  gap: 12rpx;
  margin-bottom: 8rpx;
}

.poem-title {
  font-size: 30rpx;
  font-weight: bold;
  color: #333;
}

.poem-author {
  font-size: 22rpx;
  color: #999;
}

.poem-preview {
  font-size: 24rpx;
  color: #777;
  display: block;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
  font-family: serif;
}

.tag {
  flex-shrink: 0;
  padding: 6rpx 18rpx;
  border-radius: 20rpx;
  font-size: 22rpx;
}

.tag-green {
  background: #F6FFED;
  color: #52C41A;
  border: 1rpx solid #B7EB8F;
}

.tag-gray {
  background: #F5F5F5;
  color: #BFBFBF;
  border: 1rpx solid #E8E8E8;
}

/* ===== 生字网格 ===== */
.chinese-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  padding: 24rpx;
}

.chinese-card {
  width: calc(25% - 12rpx);
  aspect-ratio: 1;
  background: #fff;
  border-radius: 16rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  position: relative;
  box-shadow: 0 2rpx 10rpx rgba(0,0,0,0.06);
  border: 2rpx solid transparent;
}

.chinese-card.chinese-mastered {
  background: #F6FFED;
  border-color: #B7EB8F;
}

.chinese-char {
  font-size: 48rpx;
  font-weight: bold;
  color: #333;
  line-height: 1.2;
}

.chinese-pinyin {
  font-size: 20rpx;
  color: #888;
  margin-top: 6rpx;
}

.mastered-badge {
  position: absolute;
  top: 6rpx;
  right: 8rpx;
}

.mastered-check {
  font-size: 22rpx;
  color: #52C41A;
}

/* ===== 英语单词卡片 ===== */
.word-card {
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: #fff;
  margin: 16rpx 24rpx 0;
  border-radius: 20rpx;
  padding: 24rpx 24rpx;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.05);
  border-left: 6rpx solid #E8E8E8;
}

.word-card.word-mastered {
  border-left-color: #52C41A;
  background: #FAFFF5;
}

.word-left {
  flex: 1;
}

.word-en {
  display: block;
  font-size: 34rpx;
  font-weight: bold;
  color: #222;
  margin-bottom: 6rpx;
}

.word-cn {
  display: block;
  font-size: 26rpx;
  color: #666;
  margin-bottom: 4rpx;
}

.word-phonetic {
  display: block;
  font-size: 22rpx;
  color: #AAA;
}

.word-right {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  gap: 12rpx;
}

.level-tag {
  font-size: 22rpx;
  padding: 4rpx 16rpx;
  border-radius: 20rpx;
  border: 1rpx solid;
}

.toggle-btn {
  font-size: 24rpx;
  padding: 8rpx 20rpx;
  border-radius: 20rpx;
}

.toggle-mastered {
  background: #F6FFED;
  color: #52C41A;
}

.toggle-unmastered {
  background: #F0F5FF;
  color: #4876FF;
}
