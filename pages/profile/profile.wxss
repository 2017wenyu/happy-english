/* pages/profile/profile.wxss */
.container {
  background: #F5F8FF;
  min-height: 100vh;
  padding-bottom: 60rpx;
}

/* 学科切换 Tab */
.subject-tabs {
  display: flex;
  background: #FFFFFF;
  padding: 16rpx 24rpx 0;
  gap: 8rpx;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.06);
}

.subject-tab {
  flex: 1;
  text-align: center;
  font-size: 26rpx;
  color: #999;
  padding: 16rpx 0 20rpx;
  border-bottom: 4rpx solid transparent;
  font-weight: 500;
  transition: all 0.2s;
}

.subject-tab.tab-active {
  color: #4876FF;
  border-bottom-color: #4876FF;
  font-weight: 700;
}

/* 顶部统计 */
.stats-header {
  background: linear-gradient(135deg, #4876FF, #722ED1);
  padding: 48rpx 36rpx 44rpx;
  border-radius: 0 0 48rpx 48rpx;
  margin-bottom: 24rpx;
}

.stats-title {
  font-size: 38rpx;
  font-weight: 700;
  color: #FFFFFF;
  display: block;
  margin-bottom: 28rpx;
}

.stats-grid {
  display: grid;
  grid-template-columns: 1fr 1fr 1fr 1fr;
  gap: 16rpx;
  margin-bottom: 28rpx;
}

.stat-card {
  background: rgba(255,255,255,0.18);
  border-radius: 20rpx;
  padding: 20rpx 12rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  backdrop-filter: blur(10px);
}

.stat-num {
  font-size: 48rpx;
  font-weight: 900;
  color: #FFFFFF;
  line-height: 1;
  margin-bottom: 8rpx;
}

.stat-num.blue { color: #BAE0FF; }
.stat-num.orange { color: #FFD591; }
.stat-num.green { color: #B7EB8F; }
.stat-num.red { color: #FFADD2; }

.stat-label {
  font-size: 20rpx;
  color: rgba(255,255,255,0.85);
  text-align: center;
}

/* 总体进度 */
.total-progress {
  background: rgba(255,255,255,0.15);
  border-radius: 20rpx;
  padding: 20rpx 24rpx;
}

.progress-label-row {
  display: flex;
  justify-content: space-between;
  margin-bottom: 12rpx;
}

.progress-label {
  font-size: 26rpx;
  color: rgba(255,255,255,0.9);
}

.progress-pct {
  font-size: 26rpx;
  color: #FFFFFF;
  font-weight: 700;
}

/* 通用卡片 */
.section-card {
  background: #FFFFFF;
  border-radius: 24rpx;
  margin: 0 24rpx 24rpx;
  padding: 32rpx;
  box-shadow: 0 4rpx 20rpx rgba(0,0,0,0.06);
}

.section-title {
  font-size: 30rpx;
  font-weight: 700;
  color: #333;
  display: block;
  margin-bottom: 24rpx;
}

/* 级别列表 */
.level-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.level-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.level-emoji-sm {
  font-size: 36rpx;
  flex-shrink: 0;
}

.level-detail {
  flex: 1;
}

.level-row-top {
  display: flex;
  justify-content: space-between;
  margin-bottom: 8rpx;
}

.level-name-sm {
  font-size: 26rpx;
  color: #555;
  font-weight: 600;
}

.level-count-sm {
  font-size: 24rpx;
  font-weight: 600;
}

/* 设置行 */
.setting-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #F5F5F5;
}

.setting-row:last-child {
  border-bottom: none;
}

.setting-left {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.setting-icon {
  font-size: 36rpx;
}

.setting-name {
  font-size: 30rpx;
  color: #333;
  font-weight: 500;
}

.setting-arrow {
  font-size: 28rpx;
  color: #AAA;
}

.setting-arrow.mode-on {
  color: #52C41A;
}

/* 家长面板 */
.parent-panel {
  border: 2rpx solid #52C41A20;
}

.parent-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.exit-btn {
  font-size: 26rpx;
  color: #FF4D4F;
  background: #FFF2F0;
  padding: 8rpx 20rpx;
  border-radius: 16rpx;
}

.parent-btns {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  margin-top: 8rpx;
}

.parent-btn {
  border-radius: 16rpx;
  font-size: 28rpx;
  font-weight: 600;
  padding: 24rpx 0;
  border: none;
  text-align: center;
}

.reset-btn {
  background: #E6F7FF;
  color: #1890FF;
}

.danger-btn {
  background: #FFF2F0;
  color: #FF4D4F;
}

.pwd-btn {
  background: #F6FFED;
  color: #52C41A;
}

/* 即将上线提示 */
.coming-soon-tip {
  background: rgba(255,255,255,0.15);
  border-radius: 20rpx;
  padding: 24rpx;
  text-align: center;
}

.coming-soon-text {
  font-size: 26rpx;
  color: rgba(255,255,255,0.9);
}

/* 错题本入口卡片 */
.mistake-entry {
  display: flex;
  align-items: center;
  justify-content: space-between;
  cursor: pointer;
  active-opacity: 0.7;
}

.mistake-entry-left {
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.mistake-entry-icon {
  font-size: 44rpx;
}

.mistake-entry-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #333;
  display: block;
  margin-bottom: 6rpx;
}

.mistake-entry-sub {
  font-size: 24rpx;
  color: #999;
  display: block;
}

.mistake-entry-arrow {
  font-size: 40rpx;
  color: #CCC;
  font-weight: 300;
}

/* 关于 */
.about-card {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 24rpx;
  gap: 8rpx;
}

.about-text {
  font-size: 24rpx;
  color: #BBB;
}

.about-sub {
  font-size: 22rpx;
  color: #CCC;
}

/* 弹窗 */
.modal-overlay {
  position: fixed;
  top: 0; left: 0; right: 0; bottom: 0;
  background: rgba(0,0,0,0.5);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 999;
}

.modal-box {
  background: #FFFFFF;
  border-radius: 32rpx;
  padding: 48rpx 40rpx 40rpx;
  width: 600rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.modal-title {
  font-size: 36rpx;
  font-weight: 700;
  color: #1a1a2e;
  margin-bottom: 12rpx;
}

.modal-desc {
  font-size: 26rpx;
  color: #888;
  margin-bottom: 32rpx;
  text-align: center;
}

.pwd-input {
  width: 100%;
  border: 2rpx solid #E0E0E0;
  border-radius: 16rpx;
  padding: 24rpx 28rpx;
  font-size: 36rpx;
  text-align: center;
  letter-spacing: 8rpx;
  color: #1a1a2e;
  box-sizing: border-box;
}

.pwd-error {
  font-size: 24rpx;
  color: #FF4D4F;
  margin-top: 12rpx;
}

.modal-btns {
  display: flex;
  gap: 20rpx;
  margin-top: 36rpx;
  width: 100%;
}

.modal-btn {
  flex: 1;
  border-radius: 16rpx;
  font-size: 30rpx;
  font-weight: 600;
  padding: 24rpx 0;
  border: none;
  text-align: center;
}

.cancel-btn {
  background: #F5F5F5;
  color: #888;
}

.confirm-btn {
  background: linear-gradient(135deg, #4876FF, #722ED1);
  color: #FFFFFF;
}
