/* pages/index/index.wxss */

.container {
  min-height: 100vh;
  background: #F5F8FF;
  padding-bottom: 60rpx;
}

/* ===== 顶部 Banner ===== */
.header {
  background: linear-gradient(135deg, #4876FF, #722ED1);
  padding: 72rpx 40rpx 56rpx;
  border-radius: 0 0 48rpx 48rpx;
  margin-bottom: 36rpx;
}

.header-inner {
  display: flex;
  flex-direction: column;
}

.app-title {
  font-size: 48rpx;
  font-weight: 800;
  color: #FFFFFF;
  margin-bottom: 10rpx;
  letter-spacing: 2rpx;
}

.app-subtitle {
  font-size: 28rpx;
  color: rgba(255,255,255,0.85);
}

/* ===== 段落标题 ===== */
.section-label {
  font-size: 30rpx;
  font-weight: 700;
  color: #333;
  padding: 0 32rpx 20rpx;
}

/* ===== 学科列表 ===== */
.subject-list {
  padding: 0 24rpx;
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.subject-card {
  background: #FFFFFF;
  border-radius: 28rpx;
  padding: 28rpx 24rpx;
  display: flex;
  align-items: center;
  box-shadow: 0 4rpx 20rpx rgba(0,0,0,0.06);
  transition: transform 0.15s;
}

.subject-card:active {
  transform: scale(0.98);
}

/* 左侧图标 */
.subject-icon-wrap {
  width: 100rpx;
  height: 100rpx;
  border-radius: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  margin-right: 24rpx;
}

.subject-emoji {
  font-size: 52rpx;
  line-height: 1;
}

/* 中间文字 */
.subject-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}

.subject-name-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.subject-name {
  font-size: 34rpx;
  font-weight: 700;
  color: #222;
}

.badge-soon {
  font-size: 20rpx;
  color: #FA8C16;
  background: rgba(250,140,22,0.12);
  border-radius: 20rpx;
  padding: 4rpx 14rpx;
  font-weight: 600;
}

.subject-desc {
  font-size: 26rpx;
  color: #666;
}

.subject-tag {
  font-size: 22rpx;
  color: #999;
}

/* 右侧箭头 */
.subject-arrow {
  width: 44rpx;
  height: 44rpx;
  background: #F0F4FF;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  margin-left: 16rpx;
}

.subject-arrow.arrow-dim {
  background: #F5F5F5;
}

.arrow-icon {
  font-size: 36rpx;
  color: #4876FF;
  font-weight: 700;
  line-height: 1;
  margin-top: -4rpx;
}

.subject-arrow.arrow-dim .arrow-icon {
  color: #CCCCCC;
}

/* ===== 底部 ===== */
.footer {
  margin-top: 48rpx;
  text-align: center;
}

.footer-text {
  font-size: 24rpx;
  color: #BBBBBB;
}
