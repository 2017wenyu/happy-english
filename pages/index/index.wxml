<!--pages/index/index.wxml-->
<view class="container">

  <!-- 顶部 banner -->
  <view class="header">
    <view class="header-inner">
      <text class="app-title">📚 小学学习助手</text>
      <text class="app-subtitle">快乐学习，每天进步一点点</text>
    </view>
  </view>

  <!-- 学科入口 -->
  <view class="section-label">选择学习内容</view>
  <view class="subject-list">
    <view
      class="subject-card"
      wx:for="{{subjects}}"
      wx:key="key"
      bindtap="goSubject"
      data-key="{{item.key}}"
      data-available="{{item.available}}"
    >
      <!-- 左侧图标区 -->
      <view class="subject-icon-wrap" style="background: {{item.gradient}}">
        <text class="subject-emoji">{{item.emoji}}</text>
      </view>

      <!-- 中间文字区 -->
      <view class="subject-info">
        <view class="subject-name-row">
          <text class="subject-name">{{item.name}}</text>
          <text wx:if="{{!item.available}}" class="badge-soon">即将上线</text>
        </view>
        <text class="subject-desc">{{item.desc}}</text>
        <text class="subject-tag">{{item.tag}}</text>
      </view>

      <!-- 右侧箭头 -->
      <view class="subject-arrow {{item.available ? '' : 'arrow-dim'}}">
        <text class="arrow-icon">›</text>
      </view>
    </view>
  </view>

  <!-- 底部版权 -->
  <view class="footer">
    <text class="footer-text">更多功能持续更新中 ✨</text>
  </view>

</view>
